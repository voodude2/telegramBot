# ─── Required in production ──────────────────────────────────────────────────
# Signs user JWTs. The app REFUSES TO START in production without it, and
# generates a throwaway value elsewhere. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Protects every /api/admin route and the product cache refresh.
# Unset in production => admin routes return 503 (fails closed).
ADMIN_API_KEY=

# Comma-separated allowed origins for the browser frontend. A wildcard is
# REFUSED in production. Must be the EXACT origin the browser sends: scheme +
# host, no trailing slash, no path. This is your FRONTEND's URL, not the API's.
#   e.g. FRONTEND_URL=https://telegrambot-frontend.onrender.com
# Leave blank here on purpose — a copied placeholder is silently wrong, and a
# wrong value blocks every browser request while the server logs look healthy.
FRONTEND_URL=

# ─── Core services ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
MEM0_API_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Google Sheets (products + FAQ_Policies) ─────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
# Sheet tab names. Products defaults to the first tab.
GOOGLE_PRODUCTS_SHEET=
GOOGLE_POLICY_SHEET=FAQ_Policies

# ─── Optional tuning (defaults shown) ────────────────────────────────────────
PORT=3000
JWT_EXPIRES_IN=7d

# Model fallback chain, tried in order. The first model that answers is cached
# for the process lifetime, so a stale leading entry costs one call, not one per request.
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-1.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Cost-dashboard rates in USD per token. The built-in defaults are ESTIMATES —
# override with current published pricing for accurate reporting.
# GEMINI_PRICING={"gemini-3.1-flash-lite":{"input":0.0000001,"output":0.0000004}}

# Rate limits: requests per window, per IP.
# RATE_LIMIT_CHAT=20     # per 5 minutes
# RATE_LIMIT_AUTH=10     # per 15 minutes
# RATE_LIMIT_API=300     # per 15 minutes

# MAX_BODY_MB=10
# MAX_MEDIA_BYTES=8388608
# MAX_MESSAGE_CHARS=4000
# CHAT_HISTORY_TURNS=40
# IN_MEMORY_SESSIONS=500

# RAG_THRESHOLD=0.65
# RAG_REFRESH_MS=0       # >0 re-indexes the policy sheet on this interval
# PRODUCTS_CACHE_TTL_MS=30000
